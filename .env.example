# Cairn — LLM provider configuration.
# Set the keys for the providers your agents should be able to use.
# A provider without a key still shows up in the UI, but its agents will fail.
# Instance admins can also store these under Admin -> Instance settings in the
# UI (encrypted at rest); a value stored there WINS over the variable here.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Ollama base URL. From inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=

# Any OpenAI-compatible endpoint — e.g. a self-hosted LiteLLM proxy, vLLM or
# LM Studio. Cairn talks to it directly for ceremonies and the built-in
# tool-loop executor; type the model name the endpoint expects when creating
# agents. Key is optional (many local endpoints ignore it).
#OPENAI_COMPATIBLE_BASE_URL=http://localhost:4000/v1
#OPENAI_COMPATIBLE_API_KEY=

# SQLite location. Defaults to ./data/cairn.db (docker-compose overrides this).
#DATABASE_PATH=

# Public URL when running behind a reverse proxy (nginx/Caddy/Traefik).
# REQUIRED in that setup: without it CSRF protection rejects every form
# submission and OIDC redirect URIs point at the internal address.
# See "Behind a reverse proxy" in the README.
#ORIGIN=https://cairn.example.com

# Signup is open only while the instance has no users (the first account
# becomes the owner). Set to "true" to let further people register — careful
# on shared deployments: provider API keys are server-global for now, so
# anyone who can sign up can spend them.
#CAIRN_ALLOW_SIGNUP=

# ---- OIDC single sign-on (optional) --------------------------------------
# NOTE: since issue #25, SSO providers are managed in the UI (Admin -> SSO
# providers) — several at once, no restart needed. The variables below are a
# single-provider BOOTSTRAP FALLBACK: they apply only while no provider is
# configured in the admin UI, and are ignored as soon as one is.
#
# Any spec-compliant provider (Keycloak, Authentik, Nextcloud, Azure AD, ...).
# Register a confidential client with redirect URI <origin>/login/oidc/callback,
# then set issuer + client id (secret strongly recommended). Accounts are
# created on first login (CAIRN_ALLOW_SIGNUP does not apply to SSO — the IdP
# and the group mapping below decide who gets in).
#CAIRN_OIDC_ISSUER=https://auth.example.com/realms/main
#CAIRN_OIDC_CLIENT_ID=
#CAIRN_OIDC_CLIENT_SECRET=

# Group -> role mapping, read from the groups claim (default claim: "groups";
# make sure your provider includes it, e.g. via CAIRN_OIDC_SCOPES below).
# Users in the member group get full accounts (create teams/projects);
# users in the viewer group are read-only guests; users in neither are
# rejected. Leave BOTH unset to make every authenticated user a member.
# Roles are re-mapped on every login, so group changes in the IdP propagate.
#CAIRN_OIDC_GROUP_MEMBER=cairn-members
#CAIRN_OIDC_GROUP_VIEWER=cairn-viewers

# Requested scopes; add your provider's groups scope if it needs one
# (e.g. "openid profile email groups"). Default: openid profile email
#CAIRN_OIDC_SCOPES=
# Claim holding the group list. Default: groups
#CAIRN_OIDC_GROUPS_CLAIM=
# Label for the SSO button on the login page. Default: Single sign-on
#CAIRN_OIDC_LABEL=

# Key for encrypting secrets at rest (git hosting tokens, executor
# credentials, SSO client secrets, admin-stored API keys) — 64 hex chars.
# Optional: without it a key is auto-generated into <data dir>/token.key.
# Generate one with: openssl rand -hex 32
#CAIRN_TOKEN_KEY=

# ---- Team workspaces (Docker) -------------------------------------------
# Image for the per-team workspace containers. Needs git. The default is the
# pre-built worker image (node:24-bookworm + the CLI executor tools already
# installed); when it cannot be pulled, Cairn falls back to plain
# node:24-bookworm and installs the tools at run time instead.
#WORKSPACE_IMAGE=ghcr.io/firn-labs/cairn-worker:latest

# When the default worker image is already present locally, it is re-pulled on
# workspace start to pick up the weekly rebuild. The start waits at most ~20s;
# a slow or real download continues in the background and applies from the
# next start. A missing image is always pulled, regardless of this setting.
#   always  (default) check the registry on every workspace start
#   daily   at most one registry check per 24h (resets on app restart)
#   never   no refresh — useful for air-gapped or metered setups
#WORKSPACE_IMAGE_PULL=

# Set to "none" to cut workspace containers off from the network
# (agents then cannot npm install etc.; teams with a git hosting project
# need network access to clone/push).
#WORKSPACE_NETWORK=

# Docker endpoint override. Usually unnecessary: the daemon is auto-detected
# (named pipe on Windows, /var/run/docker.sock elsewhere).
#DOCKER_HOST=

# Instance-default work-phase executor; each team can override it in the UI.
#   tool-loop   (default) metered AI SDK tool loop with the agent's provider
#   claude-code Claude Code CLI in the workspace (subscription or API key)
#   codex       Codex CLI in the workspace (subscription or API key)
#   opencode    OpenCode CLI against your Ollama server
#   mock        no LLM — writes a marker file per item; for testing
# CLI executors need workspace network access (WORKSPACE_NETWORK not "none").
# Subscription credentials are stored per user under Settings in the UI;
# without one, claude-code falls back to ANTHROPIC_API_KEY and codex to
# OPENAI_API_KEY from this file.
#CAIRN_EXECUTOR=
