# Cairn — LLM provider configuration.
# Set the keys for the providers your agents should be able to use.
# A provider without a key still shows up in the UI, but its agents will fail.

ANTHROPIC_API_KEY=
OPENAI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=

# Ollama base URL. From inside Docker use http://host.docker.internal:11434
OLLAMA_BASE_URL=

# SQLite location. Defaults to ./data/cairn.db (docker-compose overrides this).
#DATABASE_PATH=

# Signup is open only while the instance has no users (the first account
# becomes the owner). Set to "true" to let further people register — careful
# on shared deployments: provider API keys are server-global for now, so
# anyone who can sign up can spend them.
#CAIRN_ALLOW_SIGNUP=

# ---- OIDC single sign-on (optional) --------------------------------------
# Any spec-compliant provider (Keycloak, Authentik, Nextcloud, Azure AD, ...).
# Register a confidential client with redirect URI <origin>/login/oidc/callback,
# then set issuer + client id (secret strongly recommended). Accounts are
# created on first login (CAIRN_ALLOW_SIGNUP does not apply to SSO — the IdP
# and the group mapping below decide who gets in).
#CAIRN_OIDC_ISSUER=https://auth.example.com/realms/main
#CAIRN_OIDC_CLIENT_ID=
#CAIRN_OIDC_CLIENT_SECRET=

# Group -> role mapping, read from the groups claim (default claim: "groups";
# make sure your provider includes it, e.g. via CAIRN_OIDC_SCOPES below).
# Users in the member group get full accounts (create teams/projects);
# users in the viewer group are read-only guests; users in neither are
# rejected. Leave BOTH unset to make every authenticated user a member.
# Roles are re-mapped on every login, so group changes in the IdP propagate.
#CAIRN_OIDC_GROUP_MEMBER=cairn-members
#CAIRN_OIDC_GROUP_VIEWER=cairn-viewers

# Requested scopes; add your provider's groups scope if it needs one
# (e.g. "openid profile email groups"). Default: openid profile email
#CAIRN_OIDC_SCOPES=
# Claim holding the group list. Default: groups
#CAIRN_OIDC_GROUPS_CLAIM=
# Label for the SSO button on the login page. Default: Single sign-on
#CAIRN_OIDC_LABEL=

# Key for encrypting git hosting tokens at rest (64 hex chars = 32 bytes).
# Optional: without it a key is auto-generated into <data dir>/token.key.
# Generate one with: openssl rand -hex 32
#CAIRN_TOKEN_KEY=

# ---- Team workspaces (Docker) -------------------------------------------
# Image for the per-team workspace containers. Needs git; the default also
# ships Node for building/testing JS projects.
#WORKSPACE_IMAGE=node:24-bookworm

# Set to "none" to cut workspace containers off from the network
# (agents then cannot npm install etc.; teams with a git hosting project
# need network access to clone/push).
#WORKSPACE_NETWORK=

# Docker endpoint override. Usually unnecessary: the daemon is auto-detected
# (named pipe on Windows, /var/run/docker.sock elsewhere).
#DOCKER_HOST=

# Work-phase executor: tool-loop (default, real LLM agents) or mock
# (no LLM — writes a marker file per item; for testing the pipeline).
#CAIRN_EXECUTOR=
